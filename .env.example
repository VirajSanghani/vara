# VARA prototype secrets/config. Copy to .env (gitignored — NEVER commit the real key).
#   cp .env.example .env  &&  edit

# Cloud vision API key (Phase 1: identify+explain is a cloud call, no on-device VLM).
# Without it, VARA runs in degraded mode and shows a clean "No API key" screen — it won't crash.
ANTHROPIC_API_KEY=

# Vision model (fast vision-capable default). Optional.
VARA_MODEL=claude-haiku-4-5

# Force all subsystems to stubs even on a Pi (handy for bench logic tests). Optional.
VARA_FORCE_STUBS=0
